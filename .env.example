NEXT_PUBLIC_SITE_NAME="Nexo TCG"
APP_MODE=demo
# Empty uses embedded PostgreSQL (PGlite) for local development only.
DATABASE_URL=
DATA_DIR=.data/postgres
APP_URL=http://localhost:3000
PAYMENT_PROVIDER=sandbox
# Set a random value for authenticated sandbox webhooks, never NEXT_PUBLIC.
SANDBOX_WEBHOOK_SECRET=
REAL_BOOSTERS_ENABLED=false
# Production e-mail delivery requires SMTP. Demo uses a private local outbox.
SMTP_URL=
MAIL_FROM=Nexo TCG <contato@example.com>

MAIL_OUTBOX_DIR=.data/outbox
# Only tests read this; point to a dedicated disposable database, never production.
NEXO_TEST_DATABASE_URL=
